  "css": ":root { --berserk-miniature: url(\"data:image/jpeg;base64,\"); }\n/* Berserk - Eclipse: Illustrated. Embedded artwork is added during packaging. */\n:root {\n  --berserk-crimson: #b52d43;\n  --berserk-bone: #e6dfd2;\n}\n.dark [data-slot=\"sidebar-inner\"] {\n  position: relative;\n  isolation: isolate;\n  background-image: linear-gradient(180deg, rgba(9,8,10,.94), rgba(9,8,10,.68)), var(--berserk-miniature) !important;\n  background-position: center, right -8px bottom 56px !important;\n  background-size: 100% 100%, 180px auto !important;\n  background-repeat: no-repeat !important;\n}\n.dark [data-workspace-area=\"conversation\"] {\n  position: relative;\n  isolation: isolate;\n  background-image: radial-gradient(ellipse at 95% 3%, rgba(123,27,48,.09), transparent 45%) !important;\n}\n.dark [data-workspace-area=\"conversation\"]::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  pointer-events: none;\n  top: 34px;\n  right: 30px;\n  width: clamp(96px, 15vw, 170px);\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: radial-gradient(circle, #0c0b0c 0 37%, rgba(237,116,114,.65) 38%, #9d293c 39%, rgba(122,23,45,.19) 42%, transparent 64%);\n  opacity: .29;\n  animation: berserk-eclipse-breathe 14s ease-in-out infinite;\n}\n.dark [data-workspace-area=\"conversation\"]::after {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  pointer-events: none;\n  right: 20px;\n  bottom: 22px;\n  width: 110px;\n  height: 166px;\n  background: var(--berserk-miniature) center bottom / contain no-repeat;\n  mask-image: radial-gradient(ellipse, #000 38%, transparent 73%);\n  opacity: .10;\n  animation: berserk-cloak-drift 11s ease-in-out infinite;\n}\n.dark [data-chat-header] {\n  border-bottom: 1px solid #39232c !important;\n  background-image: linear-gradient(100deg, rgba(110,23,43,.12), transparent 58%) !important;\n}\n.dark [data-thread-item] {\n  transition: background-color 180ms ease, box-shadow 180ms ease !important;\n}\n.dark [data-thread-item]:hover {\n  box-shadow: inset 2px 0 0 #a83b4e !important;\n}\n.dark [data-slot=\"project-monogram\"] {\n  border-radius: 5px !important;\n  box-shadow: 0 0 0 1px rgba(175,64,85,.24) !important;\n}\n.dark [data-user-message-bubble] {\n  border: 1px solid rgba(171,65,85,.25) !important;\n  border-radius: 13px 13px 4px 13px !important;\n  background-image: linear-gradient(135deg, rgba(115,35,55,.10), transparent 70%) !important;\n}\n.dark [data-slot=\"composer-host\"] {\n  border: 1px solid #493039 !important;\n  box-shadow: 0 8px 28px rgba(0,0,0,.23), inset 0 1px 0 rgba(230,223,210,.035) !important;\n  transition: border-color 220ms ease, box-shadow 220ms ease !important;\n}\n.dark [data-slot=\"composer-host\"]:focus-within {\n  border-color: #a34458 !important;\n  box-shadow: 0 0 0 2px rgba(181,45,67,.10), 0 8px 28px rgba(0,0,0,.23) !important;\n}\n.dark .chat-markdown-codeblock {\n  border: 1px solid #3b2c31 !important;\n  border-radius: 8px !important;\n}\n.dark .chat-markdown h1, .dark .chat-markdown h2, .dark .chat-markdown h3 {\n  color: #eee0c9 !important;\n}\n.dark .chat-markdown blockquote {\n  border-left-color: #a43a50 !important;\n}\n.dark [data-slot=\"button\"], .dark [data-slot=\"select-trigger\"] {\n  transition: background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease !important;\n}\n.dark [data-slot=\"button\"]:hover:not(:disabled) {\n  box-shadow: 0 0 12px rgba(181,45,67,.09) !important;\n}\n.dark [data-slot=\"dialog-popup\"], .dark [data-slot=\"popover-popup\"], .dark [data-slot=\"menu-popup\"] {\n  border-color: #52313e !important;\n  box-shadow: 0 18px 52px rgba(0,0,0,.4) !important;\n}\n.dark [data-slot=\"scroll-area-thumb\"] {\n  background-color: #65404e !important;\n}\n.dark svg.lucide {\n  stroke-width: 1.6;\n}\n@keyframes berserk-eclipse-breathe {\n  0%, 100% { opacity: .22; transform: scale(.98); }\n  50% { opacity: .34; transform: scale(1.025); }\n}\n@keyframes berserk-cloak-drift {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-3px); }\n}\n@media (max-width: 760px) {\n  .dark [data-workspace-area=\"conversation\"]::before { width: 96px; right: 12px; opacity: .18; }\n  .dark [data-workspace-area=\"conversation\"]::after { display: none; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .dark [data-workspace-area=\"conversation\"]::before { animation: none !important; opacity: .26; transform: none !important; }\n  .dark [data-workspace-area=\"conversation\"]::after { animation: none !important; transform: none !important; }\n  .dark [data-thread-item], .dark [data-slot=\"composer-host\"], .dark [data-slot=\"button\"], .dark [data-slot=\"select-trigger\"] { transition: none !important; }\n}\n\n:root{--berserk-pixel-sword:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2024%22%20shape-rendering%3D%22crispEdges%22%3E%3Cpath%20fill%3D%22%23e6dfd2%22%20d%3D%22M13%200h2v1H13zM12%201h1v1H12zM14%201h1v1H14zM11%202h1v1H11zM14%202h1v1H14zM10%203h1v1H10zM13%203h2v1H13zM9%204h1v1H9zM12%204h2v1H12zM8%205h1v1H8zM11%205h2v1H11zM7%206h1v1H7zM10%206h2v1H10zM6%207h1v1H6zM9%207h2v1H9zM5%208h1v1H5zM8%208h2v1H8zM4%209h1v1H4zM7%209h2v1H7zM3%2010h1v1H3zM6%2010h2v1H6zM3%2011h1v1H3zM5%2011h2v1H5zM4%2012h2v1H4z%22%2F%3E%3Cpath%20fill%3D%22%23a99d9b%22%20d%3D%22M13%201h1v1H13zM12%202h1v1H12zM11%203h1v1H11zM10%204h1v1H10zM9%205h1v1H9zM8%206h1v1H8zM7%207h1v1H7zM6%208h1v1H6zM5%209h1v1H5zM4%2010h1v1H4zM2%2013h1v1H2zM6%2013h1v1H6zM3%2014h1v1H3zM5%2014h1v1H5zM1%2018h2v1H1z%22%2F%3E%3Cpath%20fill%3D%22%2369616a%22%20d%3D%22M13%202h1v1H13zM12%203h1v1H12zM11%204h1v1H11zM10%205h1v1H10zM9%206h1v1H9zM8%207h1v1H8zM7%208h1v1H7zM6%209h1v1H6zM5%2010h1v1H5zM4%2011h1v1H4zM3%2013h3v1H3zM4%2014h1v1H4z%22%2F%3E%3Cpath%20fill%3D%22%2339333d%22%20d%3D%22M3%2015h1v1H3zM2%2016h1v1H2zM1%2017h1v1H1z%22%2F%3E%3Cpath%20fill%3D%22%238c243e%22%20d%3D%22M4%2015h1v1H4zM3%2016h1v1H3zM2%2017h1v1H2z%22%2F%3E%3C%2Fsvg%3E\");\n--berserk-pixel-sigil: